---
import { Icon } from 'astro-icon/components';
import Chispa from './Chispa.astro';
import WaButton from './WaButton.astro';
import { packages } from '../site';
---
<div class="grid gap-6 lg:grid-cols-3 lg:items-stretch">
  {packages.map((p, i) => (
    <article id={p.id} class:list={['pkg', p.featured && 'pkg--featured']} data-reveal style={`--d:${i * 90}ms`}>
      {p.featured && <p class="label absolute right-6 top-6 rounded-full bg-carbon px-3 py-1.5 text-arena">Recomendado</p>}
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class:list={['label', p.featured ? 'text-carbon/70' : 'text-chispa']}>{p.tag}</p>
          <h3 class="mt-2 font-display text-5xl font-extrabold md:text-6xl" style="font-variation-settings:'opsz' 96; letter-spacing:-.04em">{p.name}</h3>
        </div>
        {!p.featured && <Chispa class="pkg__spark size-11 shrink-0 text-fuego" stroke={46} />}
      </div>
      <p class="label mt-5 inline-flex w-fit items-center gap-2 rounded-full border border-current/30 px-3 py-1.5">
        <Icon name="ph:clock-bold" class="size-4" aria-hidden="true" />{p.time}
      </p>
      <p class:list={['mt-5 text-lg', p.featured ? 'text-carbon/85' : 'opacity-80']}>{p.summary}</p>
      <ul class="mt-6 flex-1 space-y-3">
        {p.items.map((it) => (
          <li class="flex gap-3">
            <Icon name="ph:check-circle-bold" class:list={['mt-1 size-5 shrink-0', p.featured ? 'text-carbon' : 'text-fuego']} aria-hidden="true" />
            <span>{it}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8 border-t border-current/20 pt-6">
        {p.from && <p class="label opacity-70">Desde</p>}
        {p.from && <p class="stat mt-1">{p.from}</p>}
        <WaButton
          message={`Hola, me interesa el paquete ${p.name} de Traka.`}
          label={`Quiero ${p.name}`}
          origin={`paquete-${p.id}`}
          variant={p.featured ? 'carbon' : 'fuego'}
          class="w-full"
        />
      </div>
    </article>
  ))}
</div>
