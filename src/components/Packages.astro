---
import { Icon } from 'astro-icon/components';
import Chispa from './Chispa.astro';
import WaButton from './WaButton.astro';
import { packages } from '../config';
interface Props { detailed?: boolean }
---
<div class="grid gap-8 lg:grid-cols-3 lg:items-stretch lg:gap-6">
  {packages.map((p) => (
    <article id={p.id} class:list={['pkg relative flex flex-col rounded-[28px] border-2 p-7 md:p-8', 'featured' in p ? 'border-carbon bg-carbon text-arena lg:-mt-6 lg:mb-6' : 'border-carbon/15 bg-papel']} data-reveal>
      {'featured' in p && <p class="label absolute -top-4 left-7 rounded-full bg-chispa px-3 py-1.5 text-carbon">Recomendado</p>}
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="label" style={`color: ${'featured' in p ? 'var(--color-chispa)' : 'var(--color-brasa)'}`}>{p.tag}</p>
          <h3 class="mt-2 text-4xl font-extrabold md:text-5xl" style="font-variation-settings: 'opsz' 96; letter-spacing: -0.03em;">{p.name}</h3>
        </div>
        <Chispa class="pkg__spark size-12 shrink-0" stroke={46} />
      </div>
      <p class="label mt-5 inline-flex w-fit items-center gap-2 rounded-full border border-current/30 px-3 py-1.5"><Icon name="ph:clock-bold" class="size-4" aria-hidden="true" />{p.time}</p>
      <p class="mt-5 text-lg" style={`color: ${'featured' in p ? 'rgb(244 238 228 / .85)' : 'rgb(30 26 23 / .8)'}`}>{p.summary}</p>
      <ul class="mt-6 flex-1 space-y-3">
        {p.items.map((it) => (
          <li class="flex gap-3"><Icon name="ph:check-circle-bold" class:list={['mt-1 size-5 shrink-0', 'featured' in p ? 'text-fuego' : 'text-brasa']} aria-hidden="true" /><span>{it}</span></li>
        ))}
      </ul>
      <div class="mt-8 border-t border-current/20 pt-6">
        <p class="label" style="opacity:.7">Desde</p>
        <p class="mt-1"><span class="label inline-block rounded bg-chispa px-2 py-1 text-carbon">[PRECIO PENDIENTE]</span></p>
        <WaButton message={`Hola, me interesa el paquete ${p.name} de Traka.`} label={`Quiero ${p.name}`} origin={`paquete-${p.id}`} variant={'featured' in p ? 'fuego' : 'carbon'} class="mt-5 w-full" />
      </div>
    </article>
  ))}
</div>
