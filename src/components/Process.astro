---
import { steps } from '../site';
---
<ol class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-4">
  {steps.map((s, i) => (
    <li data-reveal style={`--d:${i * 90}ms`}>
      <div class="flex items-center gap-4">
        <span class="num grid size-12 shrink-0 place-items-center rounded-full border-2 border-current text-sm font-medium">0{i + 1}</span>
        <span class="hidden h-1.5 flex-1 lg:block" style="background: radial-gradient(circle, var(--color-fuego) 2.4px, transparent 3px) 0 0 / 16px 6px repeat-x;" aria-hidden="true"></span>
      </div>
      <h3 class="mt-6 text-2xl">{s.t}</h3>
      <p class="mt-2 opacity-80">{s.d}</p>
    </li>
  ))}
</ol>
