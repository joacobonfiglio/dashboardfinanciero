---
import { Icon } from 'astro-icon/components';
import { topbar, waHref } from '../site';
---
<div class="topbar">
  <div class="topbar__in">
    <p class="topbar__text">{topbar.text}</p>
    <a class="topbar__cta" href={waHref(topbar.message)} data-wa="barra-superior" rel="noopener">
      {topbar.cta}
      <Icon name="ph:arrow-right-bold" class="size-3.5 shrink-0" aria-hidden="true" />
    </a>
  </div>
</div>
