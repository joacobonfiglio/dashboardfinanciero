---
interface Props { name: string; kind: string; tone: 'fuego' | 'chispa' | 'arena' | 'carbon'; }
const { name, kind, tone } = Astro.props;
const bg = { fuego: 'bg-fuego', chispa: 'bg-chispa', arena: 'bg-arena', carbon: 'bg-carbon text-arena' }[tone];
---
<article class="w-[220px] lg:w-auto" data-reveal>
  <div class="phone mx-auto !w-[170px] lg:!w-[78%] !border-[7px] !rounded-[30px]" role="img" aria-label={`Vista de la web de ${name} en un celular. Captura real pendiente.`}>
    <div class="flex h-full flex-col" aria-hidden="true">
      <div class="mt-7 flex items-center justify-between px-3 py-2 text-[10px] font-bold"><span>{name}</span><span class="h-2 w-5 rounded bg-carbon/20"></span></div>
      <div class={`mx-2.5 rounded-xl p-3 ${bg}`}>
        <div class="h-2.5 w-4/5 rounded bg-current opacity-80"></div>
        <div class="mt-1.5 h-2.5 w-3/5 rounded bg-current opacity-80"></div>
        <div class="mt-4 h-6 w-20 rounded-full bg-carbon/85"></div>
      </div>
      <div class="mx-2.5 mt-2.5 grid grid-cols-2 gap-2">
        <div class="h-14 rounded-lg bg-carbon/10"></div><div class="h-14 rounded-lg bg-carbon/10"></div>
      </div>
      <p class="mx-auto mt-auto mb-3 rounded bg-chispa px-1.5 py-0.5 font-mono text-[8px] uppercase tracking-wider">[Captura pendiente]</p>
    </div>
  </div>
  <h3 class="mt-5 text-xl lg:text-2xl">{name}</h3>
  <p class="label mt-1 text-chispa">{kind}</p>
  <p class="mt-3 text-sm text-arena/85">Antes → después: <span class="label rounded bg-chispa px-1.5 py-0.5 text-carbon">[PENDIENTE: métrica]</span></p>
</article>
