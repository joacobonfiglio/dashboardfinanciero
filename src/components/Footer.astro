---
import { Icon } from 'astro-icon/components';
import WaButton from './WaButton.astro';
import { site } from '../site';
const year = new Date().getFullYear();
---
<footer class="s-carbon relative z-10 border-t border-arena/10">
  <div class="mx-auto grid max-w-[1480px] gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:px-8 md:py-20">
    <div>
      <img src="/brand/traka-logo-negativo.svg" alt="Traka" width="141" height="48" class="h-12 w-auto" loading="lazy" />
      <p class="mt-5 max-w-sm opacity-80">Webs y Google para negocios reales.</p>
      <p class="label mt-6 text-chispa">Desde {site.city}, para negocios de {site.areaServed.join(' y ')}</p>
      {site.hours.length > 0 && (
        <ul class="mt-5 space-y-1 text-sm opacity-80">
          {site.hours.map((h) => <li>{h.d}: {h.h}</li>)}
        </ul>
      )}
    </div>
    <div>
      <h2 class="label mb-4 text-chispa">Navegar</h2>
      <ul>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/servicios/">Servicios</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/sobre-nosotros/">Sobre nosotros</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/#que-necesitas">¿Qué necesitás?</a></li>
      </ul>
      <h2 class="label mb-2 mt-6 text-chispa">Legales</h2>
      <ul>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/legales/privacidad/">Política de privacidad</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/legales/cookies/">Política de cookies</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/legales/terminos/">Términos y condiciones</a></li>
      </ul>
    </div>
    <div>
      <h2 class="label mb-4 text-chispa">Contacto</h2>
      <ul class="space-y-1">
        {site.email && (
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="ph:envelope-simple-bold" class="size-5 shrink-0" aria-hidden="true" />
            <a class="hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        {site.instagram && (
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="ph:instagram-logo-bold" class="size-5 shrink-0" aria-hidden="true" />
            <a class="hover:underline" href={site.instagram} rel="noopener">Instagram</a>
          </li>
        )}
        {site.googleBusiness && (
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="ph:map-pin-bold" class="size-5 shrink-0" aria-hidden="true" />
            <a class="hover:underline" href={site.googleBusiness} data-ga="click_como_llegar" rel="noopener">Perfil de Empresa en Google</a>
          </li>
        )}
        <li class="flex min-h-11 items-center gap-2">
          <Icon name="ph:map-trifold-bold" class="size-5 shrink-0" aria-hidden="true" />
          <span>{site.city}, {site.region}</span>
        </li>
      </ul>
      <WaButton message="Hola, te escribo desde el pie de la web de Traka." origin="footer" class="mt-5" />
    </div>
  </div>
  <div class="border-t border-arena/10 px-5 py-5 md:px-8">
    <p class="mx-auto max-w-[1480px] text-sm opacity-60">© {year} {site.name}. {site.tagline}</p>
  </div>
</footer>
