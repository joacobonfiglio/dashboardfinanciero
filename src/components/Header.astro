---
import { Icon } from 'astro-icon/components';
import WaButton from './WaButton.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/servicios/', label: 'Servicios' },
  { href: '/sobre-nosotros/', label: 'Sobre nosotros' },
  { href: '/#que-necesitas', label: '¿Qué necesitás?' },
];
const isOn = (href: string) => href.startsWith('/#') ? false : path.startsWith(href);
---
<header class="sticky top-0 z-[70] border-b border-arena/10 bg-noche/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1480px] items-center justify-between gap-4 px-5 md:h-20 md:px-8">
    <a href="/" aria-label="Traka, ir al inicio" class="flex items-center">
      <img src="/brand/traka-logo-negativo.svg" alt="Traka" width="106" height="36" class="h-8 w-auto md:h-9" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a href={l.href} class="font-medium underline-offset-8 hover:underline" aria-current={isOn(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <WaButton message="Hola, vengo desde la web de Traka y quiero hacer una consulta." label="Escribinos" origin="header" />
    </nav>
    <button type="button" id="menu-btn" class="grid size-11 place-items-center rounded-full border-2 border-arena/40 md:hidden" aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir menú">
      <Icon name="ph:list-bold" class="size-6" id="menu-open" aria-hidden="true" />
      <Icon name="ph:x-bold" class="hidden size-6" id="menu-close" aria-hidden="true" />
    </button>
  </div>
  <nav id="menu-panel" aria-label="Menú" hidden class="border-t border-arena/10 bg-noche px-5 pb-6 pt-2 md:hidden">
    <ul class="flex flex-col">
      {links.map((l) => (
        <li><a href={l.href} class="flex min-h-14 items-center border-b border-arena/10 font-display text-2xl font-bold" aria-current={isOn(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <WaButton message="Hola, vengo desde la web de Traka y quiero hacer una consulta." origin="menu-movil" class="mt-5 w-full" />
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn')!;
  const panel = document.getElementById('menu-panel')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    panel.hidden = !open;
    document.getElementById('menu-open')!.classList.toggle('hidden', open);
    document.getElementById('menu-close')!.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  panel.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
</script>
