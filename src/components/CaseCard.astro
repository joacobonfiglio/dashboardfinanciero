---
interface Props { name: string; kind: string; tone: string; url?: string; metric?: string }
const { name, kind, tone, url = '', metric = '' } = Astro.props;
const bg: Record<string, string> = { fuego: 'bg-fuego', chispa: 'bg-chispa', arena: 'bg-arena', mar: 'bg-mar' };
---
<article class="w-[230px] lg:w-auto" data-reveal>
  <div class="phone mx-auto !w-[180px] !rounded-[32px] !border-[8px] lg:!w-[86%]" role="img" aria-label={`Maqueta de la web de ${name} vista en un celular.`}>
    <div class="flex h-full flex-col" aria-hidden="true">
      <div class="mt-7 flex items-center justify-between px-3 py-2 text-[10px] font-bold"><span>{name}</span><span class="h-2 w-5 rounded bg-carbon/20"></span></div>
      <div class={`mx-2.5 rounded-xl p-3 ${bg[tone] ?? 'bg-arena'}`}>
        <div class="h-2.5 w-4/5 rounded bg-current opacity-70"></div>
        <div class="mt-1.5 h-2.5 w-3/5 rounded bg-current opacity-70"></div>
        <div class="mt-4 h-6 w-20 rounded-full bg-carbon/80"></div>
      </div>
      <div class="mx-2.5 mt-2.5 grid grid-cols-2 gap-2">
        <div class="h-14 rounded-lg bg-carbon/10"></div><div class="h-14 rounded-lg bg-carbon/10"></div>
      </div>
      <div class="mx-2.5 mb-3 mt-auto h-8 rounded-full bg-carbon/10"></div>
    </div>
  </div>
  <h3 class="mt-5 text-xl lg:text-2xl">{name}</h3>
  <p class="label mt-1.5 text-chispa">{kind}</p>
  {metric && <p class="mt-3 text-sm opacity-85">{metric}</p>}
  {url && <p class="mt-3"><a class="link text-sm" href={url} rel="noopener">Ver el sitio</a></p>}
</article>
